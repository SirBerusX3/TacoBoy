<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
        Splits the screen into the game region (above) and the zone
        occluded by the Pocket Taco clamp (below). Position is restored
        from TacoBoyPrefs at runtime and adjusted live by dragging
        boundary_handle.
    -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/boundary_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.65" />

    <FrameLayout
        android:id="@+id/gamecontainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/boundary_guideline" />

    <!-- Opaque and touch-swallowing: nothing here should be visible or reachable once clamped.
         Not focusable: see the Pocket Taco D-pad note below — this shouldn't be a D-pad
         focus target any more than it should be visible. -->
    <View
        android:id="@+id/occlusion_zone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:clickable="true"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintTop_toBottomOf="@id/boundary_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Sits in the occlusion zone rather than over the picture: the space is already
         reserved, already black, and already swallows touches, so the pad costs the game
         nothing. Hidden unless the top-row button turns it on. See TouchControls. -->
    <com.tacoboy.TouchControls
        android:id="@+id/touch_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintTop_toBottomOf="@id/boundary_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Always-present drag handle, reachable from the game region above the clamp. -->
    <View
        android:id="@+id/boundary_handle"
        android:layout_width="56dp"
        android:layout_height="24dp"
        android:background="@drawable/boundary_handle_bg"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/boundary_guideline"
        app:layout_constraintBottom_toBottomOf="@id/boundary_guideline" />

    <!-- First-run only, retired for good (on either screen) the first time
         boundary_handle is touched. See BoundaryController. -->
    <TextView
        android:id="@+id/boundary_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/boundary_hint_text"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:padding="10dp"
        android:background="@drawable/boundary_hint_bg"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/boundary_handle"
        android:layout_marginBottom="6dp" />

    <!-- Small, unobtrusive button to (re)open the ROM list. Only reachable
         from the game region, so it stays usable with the clamp attached.
         Not focusable: a hardware D-pad's key events must go to the game,
         not get intercepted as Android view-focus navigation onto app
         chrome — see TacoBoyActivity's onKeyDown/onKeyUp. Touch taps are
         unaffected; only key/D-pad-driven focus is disabled. -->
    <TextView
        android:id="@+id/library_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/library_button"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:padding="10dp"
        android:visibility="gone"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Toggled in Settings > General; only ever populated/shown when that's on (see
         TacoBoyActivity.setupRetroView). A dev/perf-check overlay, not for every player. -->
    <TextView
        android:id="@+id/fps_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:padding="10dp"
        android:visibility="gone"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shown only while turbo is actually engaged (see TacoBoyActivity.setTurboEngaged).
         Sits under the FPS overlay and is deliberately a different colour from it: one is a
         readout, this is a mode the pad is currently in, and in Toggle mode it is the only
         thing telling you so. goneMarginTop keeps it in the same place when the FPS overlay
         is switched off, which is the normal case. -->
    <TextView
        android:id="@+id/turbo_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/turbo_indicator"
        android:textColor="#FFFFD54F"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintTop_toBottomOf="@id/fps_overlay"
        app:layout_goneMarginTop="34dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mirrors library_button on the opposite corner; opens quick_menu_panel. -->
    <TextView
        android:id="@+id/menu_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_button"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:padding="10dp"
        android:visibility="gone"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Turns the on-screen pad on and off. Next to Menu rather than on the opposite end so
         the two "app chrome" controls stay together and Library keeps its corner. -->
    <TextView
        android:id="@+id/touch_controls_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/touch_controls_button"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:padding="10dp"
        android:visibility="gone"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/menu_button" />

    <LinearLayout
        android:id="@+id/quick_menu_panel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/quick_menu_panel_bg"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/menu_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/boundary_guideline">

        <!-- Hidden as one unit in Hardcore Mode (see TacoBoyPrefs.isHardcoreModeEnabled).
             RA's rules forbid save-states, not SRAM/cart-battery saves, which this
             doesn't touch at all. -->
        <LinearLayout
            android:id="@+id/save_slots_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/quick_menu_slot_row" android:id="@+id/slot_row_1" />
            <include layout="@layout/quick_menu_slot_row" android:id="@+id/slot_row_2" />
            <include layout="@layout/quick_menu_slot_row" android:id="@+id/slot_row_3" />
            <include layout="@layout/quick_menu_slot_row" android:id="@+id/slot_row_4" />
        </LinearLayout>

        <TextView
            android:id="@+id/hardcore_mode_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textSize="12sp"
            android:textColor="#CCFFFFFF"
            android:text="@string/quick_menu_hardcore_note"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#33FFFFFF" />

        <!-- Both hidden unless the on-screen pad is showing; see
             TacoBoyActivity.applyTouchControlsVisibility. -->
        <TextView
            android:id="@+id/edit_layout_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/quick_menu_edit_layout"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <TextView
            android:id="@+id/reset_layout_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/quick_menu_reset_layout"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <TextView
            android:id="@+id/reset_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/quick_menu_reset"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <!-- Text set dynamically in TacoBoyActivity.updateFastForwardToggleLabel (Off/On).
             Independent of the Settings > General mode/key binding, a touch-only alternative
             that works regardless of whether a key is bound. -->
        <TextView
            android:id="@+id/fast_forward_toggle_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <TextView
            android:id="@+id/exit_to_library_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/quick_menu_exit_to_library"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <!-- Only visible when live tracking is actually active this session (see
             TacoBoyActivity.toggleQuickMenu); nothing to pause otherwise. Text set
             dynamically in updateAchievementTrackingToggle. A lightweight per-session
             pause, distinct from Settings > Achievements' login/logout toggle. -->
        <TextView
            android:id="@+id/achievement_tracking_toggle_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/info_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/quick_menu_info"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false" />

    </LinearLayout>

    <!-- Shown until a ROM folder has been picked. -->
    <LinearLayout
        android:id="@+id/rom_picker_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/gamecontainer"
        app:layout_constraintBottom_toBottomOf="@id/gamecontainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/rom_picker_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:paddingBottom="16dp"
            android:text="@string/rom_picker_hint" />

        <Button
            android:id="@+id/rom_picker_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rom_picker_button"
            android:focusable="false"
            android:focusableInTouchMode="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
