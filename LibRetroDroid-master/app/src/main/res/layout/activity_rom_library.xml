<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Same adjustable clamp boundary as activity_tacoboy.xml (see
         BoundaryController) so the library is fully usable without
         removing the Pocket Taco. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/boundary_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.65" />

    <LinearLayout
        android:id="@+id/toolbar_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/library_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/rom_picker_dialog_title"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <!-- Only shown when a game is currently loaded underneath this screen
             (see TacoBoyActivity.openLibrary / RomLibraryActivity.EXTRA_GAME_ACTIVE) —
             an explicit way back that can't be mistaken for picking a ROM, unlike
             tapping the running game's own tile. -->
        <TextView
            android:id="@+id/resume_game_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/library_icon_resume_game"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/refresh_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/library_icon_refresh"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/download_boxart_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/library_icon_get_art"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/change_folder_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/library_icon_change_folder"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <!-- Only shown for systems where GameSystem.needsBios is true. Opens the BIOS
             manager dialog (RomLibraryActivity.showBiosDialog) and doubles as its own
             status readout — its label carries the active BIOS's region flag. The list
             deliberately lives in a dialog rather than inline under the system tabs:
             inline it cost PS1 several rows of the ROM grid, which is the screen space
             a clamp-on controller is already eating into. -->
        <TextView
            android:id="@+id/import_bios_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/library_bios_label"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/library_icon_settings"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- List-view controls, split out from toolbar_row — that row's icons plus a
         title left no room for these two without squeezing the title unreadable
         (measured: 7-8 icon buttons don't fit a single toolbar row on this
         hardware, regardless of title length). Grouped together since all three
         act on "how the list below is displayed", separate from toolbar_row's
         library-management actions. -->
    <LinearLayout
        android:id="@+id/list_controls_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/view_mode_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/sort_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/library_icon_sort"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/search_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/library_icon_search"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- One tab per GameSystem — each remembers its own folder (TacoBoyPrefs),
         so switching here is instant instead of re-picking a folder. -->
    <!-- Scrolls horizontally: seven systems already crowded a weighted row, and squeezing the
         text further would have been the wrong answer. The chevrons either side are the
         affordance — they appear only when there is actually more in that direction, and
         tapping one pages the row. Fading edges reinforce it for anyone who doesn't read the
         chevrons. See RomLibraryActivity.updateTabScrollHints. -->
    <LinearLayout
        android:id="@+id/system_tabs_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/list_controls_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tab_scroll_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/system_tabs_scroll_left"
            android:textColor="#80FFFFFF"
            android:textSize="20sp"
            android:paddingHorizontal="6dp"
            android:visibility="invisible"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <HorizontalScrollView
            android:id="@+id/system_tabs_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="20dp"
            android:focusable="false">

            <LinearLayout
                android:id="@+id/system_tabs_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_gba"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:text="@string/system_label_gba"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/tab_gb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:text="@string/system_label_gb"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/tab_gbc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:text="@string/system_label_gbc"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/tab_snes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:text="@string/system_label_snes"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/tab_lynx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:text="@string/system_label_lynx"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/tab_genesis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:text="@string/system_label_genesis"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/tab_master_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:text="@string/system_label_master_system"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tab_game_gear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:text="@string/system_label_game_gear"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tab_sg1000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:text="@string/system_label_sg1000"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tab_ps1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:text="@string/system_label_ps1"
                android:clickable="true"
                android:focusable="true" />

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tab_scroll_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/system_tabs_scroll_right"
            android:textColor="#80FFFFFF"
            android:textSize="20sp"
            android:paddingHorizontal="6dp"
            android:visibility="invisible"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false" />

    </LinearLayout>

    <!-- Toggled by search_button; toolbar stays uncluttered when not searching. -->
    <LinearLayout
        android:id="@+id/search_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/system_tabs_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/search_hint"
            android:textColor="@android:color/white"
            android:textColorHint="#88FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/boundary_hint_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <TextView
            android:id="@+id/search_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/library_icon_clear_search"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rom_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/search_row"
        app:layout_constraintBottom_toTopOf="@id/boundary_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="@android:color/white"
        android:text="@string/rom_picker_empty"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/search_row"
        app:layout_constraintBottom_toTopOf="@id/boundary_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/search_row"
        app:layout_constraintBottom_toTopOf="@id/boundary_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Opaque and touch-swallowing, matching activity_tacoboy.xml. -->
    <View
        android:id="@+id/occlusion_zone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/boundary_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/boundary_handle"
        android:layout_width="56dp"
        android:layout_height="24dp"
        android:background="@drawable/boundary_handle_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/boundary_guideline"
        app:layout_constraintBottom_toBottomOf="@id/boundary_guideline" />

    <!-- First-run only, retired for good (on either screen) the first time
         boundary_handle is touched. See BoundaryController. -->
    <TextView
        android:id="@+id/boundary_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/boundary_hint_text"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:padding="10dp"
        android:background="@drawable/boundary_hint_bg"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/boundary_handle"
        android:layout_marginBottom="6dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
