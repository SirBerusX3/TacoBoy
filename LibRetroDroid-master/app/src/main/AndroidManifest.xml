<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.android.libretrodroid">
  <uses-feature android:glEsVersion="0x00030000" android:required="true" />

  <!-- ROMs are reached through the Storage Access Framework: the user grants one folder
       and its tree URI is what gets read, which needs no storage permission at all.
       READ_EXTERNAL_STORAGE and MANAGE_EXTERNAL_STORAGE were declared here until
       2026-09-10 and never once requested, so nothing has ever depended on them.
       "All files access" on an emulator downloaded from GitHub reads as malware, and
       it bought nothing. RECORD_AUDIO went the same way: LibretroDroid's native layer
       exposes a libretro microphone interface, but no core bundled here uses one and
       the runtime permission was never requested, so it could not have worked anyway.
       Any of them can come back the day something actually needs it, along with the
       runtime request that was always missing. -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <!-- On-screen pad haptics. Normal permission, granted at install; needed because
       controlling intensity means driving the vibrator directly rather than going through
       View.performHapticFeedback, which has no strength control. -->
  <uses-permission android:name="android.permission.VIBRATE"/>

  <application
      android:name="com.tacoboy.TacoBoyApplication"
      android:allowBackup="false"
      android:fullBackupContent="false"
      android:icon="@mipmap/ic_launcher"
      android:isGame="true"
      android:label="@string/activity_title">
    <activity
        android:name="com.tacoboy.TacoBoyActivity"
        android:label="@string/tacoboy_activity_title"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:launchMode="singleTask"
        android:exported="true"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|navigation">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity
        android:name="com.tacoboy.RomLibraryActivity"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:exported="false"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|navigation" />
    <activity
        android:name="com.tacoboy.SettingsActivity"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:exported="false"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|navigation" />
    <activity
        android:name="com.tacoboy.AchievementsActivity"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:exported="false"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|navigation" />
  </application>
</manifest>
